  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.9.6"
  }
}
