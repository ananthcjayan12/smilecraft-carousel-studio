{
  "name": "smilecraft-carousel-studio",
  "private": true,
  "version": "3.0.0-alpha.1",
  "type": "module",
  "description": "Web-only multi-business carousel studio",
  "scripts": {
    "start": "node scripts/local-start.mjs",
    "dev": "node --watch scripts/local-start.mjs",
    "test": "node --test tests/*.test.mjs scripts/cloudflare/*.test.mjs",
    "cloudflare:prepare": "node scripts/cloudflare/provision.mjs",
    "cloudflare:deploy": "node scripts/cloudflare/deploy.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --config wrangler.json --outdir .worker-build",
    "cloudflare:smoke": "node scripts/cloudflare/smoke-test.mjs",
    "companion:desktop": "npm run dev --workspace @smilecraft/companion-desktop",
    "companion:build": "npm run build --workspace @smilecraft/companion-desktop --"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  },
  "workspaces": [
    "apps/companion-desktop"
  ]
}
