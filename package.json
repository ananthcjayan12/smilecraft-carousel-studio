{
  "name": "smilecraft-carousel-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Local-first multi-business carousel studio",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
