# Set these in the server process environment; this sample is documentation,
# not automatically loaded by node server/index.mjs.
PORT=4178
HOST=127.0.0.1

# For Codex/Antigravity, install and authenticate the CLI on the SAME computer.
CODEX_BIN=codex
CODEX_TIMEOUT_MS=120000
AGY_BIN=agy
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Maximum simultaneous jobs per provider, per stage, on THIS server.
# One carousel has exactly five slides, so valid values are 1..5.
# Defaults: 5 for every provider. These are app caps, NOT verified account
# quotas; lower CLI limits if your machine/account cannot sustain five workers.
# IMAGE_PARALLEL_OPENAI=5
# IMAGE_PARALLEL_GEMINI=5
# IMAGE_PARALLEL_CODEX=5
# IMAGE_PARALLEL_ANTIGRAVITY=5
# TEXT_PARALLEL_OPENAI=5
# TEXT_PARALLEL_GEMINI=5
# TEXT_PARALLEL_CODEX=5
# TEXT_PARALLEL_ANTIGRAVITY=5
# TEXT_PARALLEL_CLAUDE=5
