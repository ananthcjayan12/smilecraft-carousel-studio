# Optional. Codex CLI must be installed and authenticated on the SAME computer running this server.
CODEX_BIN=codex
CODEX_TIMEOUT_MS=120000
# Optional real AI image generation, billed separately through an API account.
# The web UI's built-in illustrated slides and uploaded photos do not need this.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
PORT=4178
HOST=127.0.0.1
