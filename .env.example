PORT=4178
HOST=127.0.0.1
# Optional: keep SQLite metadata and private assets outside the repository.
# STORAGE_ROOT=/absolute/path/to/carousel-studio-storage

CODEX_BIN=codex
CODEX_TIMEOUT_MS=600000
AGY_BIN=agy
AGY_IMAGE_TIMEOUT=10m
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Valid values are 1..5; defaults are 5.
# IMAGE_PARALLEL_OPENAI=5
# IMAGE_PARALLEL_GEMINI=5
# IMAGE_PARALLEL_CODEX=5
# IMAGE_PARALLEL_ANTIGRAVITY=5
# TEXT_PARALLEL_OPENAI=5
# TEXT_PARALLEL_GEMINI=5
# TEXT_PARALLEL_CODEX=5
# TEXT_PARALLEL_ANTIGRAVITY=5
# TEXT_PARALLEL_CLAUDE=5

# Template ZIP safety limits.
# TEMPLATE_ZIP_MAX_BYTES=90000000
# TEMPLATE_ZIP_MAX_EXPANDED_BYTES=220000000
# TEMPLATE_ZIP_MAX_FILES=200
# TEMPLATE_IMAGE_MAX_BYTES=20000000
